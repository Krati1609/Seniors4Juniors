# ==============================================================================
# Seniors4Juniors Environment Configuration Reference
# ==============================================================================
# For backend configuration: copy to backend/.env
#   cp .env.example backend/.env

PROJECT_NAME="Seniors4Juniors"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# MongoDB Connection (Local or Atlas URI)
MONGODB_URL="mongodb://localhost:27017"
DATABASE_NAME="seniors4juniors"

# Security & Cryptographic Keys
JWT_SECRET_KEY="super_secret_jwt_access_key_seniors4juniors_2026_x87d9a8c"
JWT_REFRESH_SECRET_KEY="super_secret_jwt_refresh_key_seniors4juniors_2026_b21f45c"
CSRF_SECRET_KEY="super_secret_csrf_key_seniors4juniors_2026_q89a01x"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie Settings (Set COOKIE_SECURE=true when running over HTTPS in production)
COOKIE_SECURE=false
COOKIE_SAMESITE="lax"

# CORS Whitelist (JSON array string)
CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'

# Rate Limiting & Brute-Force Lockout
RATE_LIMIT_DEFAULT="120/minute"
RATE_LIMIT_AUTH="8/minute"
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Email Verification & Password Reset
# Set EMAIL_CONSOLE_MODE=true for local developer testing (prints token links in console)
EMAIL_CONSOLE_MODE=true
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@seniors4juniors.edu"
FRONTEND_URL="http://localhost:5173"

# Brand Palette Tokens
COLOR_MARINE_BLUE="#0B3C5D"
COLOR_CRIMSON_RED="#D92626"
COLOR_WARM_BUTTER_YELLOW="#F7D070"
